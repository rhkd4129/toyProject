# ============================================================
# Spring local-s3 프로파일과 쌍으로 사용 (APP_ENV=local-s3)
# 로컬 PC에서 실제 S3 연동을 테스트할 때 사용
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_STREAM_PDF_EVENTS=pdf:events
REDIS_STREAM_PDF_RESULTS=pdf:results

# S3 설정
# true: FastAPI가 XLSX를 S3에 업로드 후 S3 key(xlsx/{taskId}.xlsx)를 outputPath에 담아 Redis 전송
S3_ENABLED=true
S3_BUCKET=toyproject-lee
S3_REGION=ap-northeast-2
# XLSX를 S3에 저장할 경로 prefix - Spring의 cloud.aws.s3.result-key-prefix와 반드시 동일해야 함
S3_RESULT_KEY_PREFIX=xlsx/


PDF_XLSX_FILE_NAME=C:\Server\PDF\CONFIG\{year}사건부.xlsx

PDF_FONT_PATH=C:\Server\PDF\CONFIG\NANUMGOTHIC.TTF
PDF_OUTPUT_PATH=C:\Server\PDF\{task_id}.xlsx
