# ============================================================
# Spring prod 프로파일과 쌍으로 사용 (APP_ENV=prod)
# Docker 컨테이너 환경 - Redis가 별도 컨테이너(redis-db)로 분리됨
# ============================================================

# Redis 설정 - Spring과 FastAPI가 메시지를 주고받는 채널
# prod에서는 Docker 서비스명(redis-db)으로 접근
REDIS_HOST=redis-db
REDIS_PORT=6379
# FastAPI → Spring Stream 명칭
REDIS_STREAM_PDF_EVENTS=pdf:events
REDIS_STREAM_PDF_RESULTS=pdf:results

# S3 설정
# true: FastAPI가 XLSX를 S3에 업로드 후 S3 key(xlsx/{taskId}.xlsx)를 outputPath에 담아 Redis 전송
S3_ENABLED=true
S3_BUCKET=toyproject-lee
S3_REGION=ap-northeast-2
# XLSX를 S3에 저장할 경로 prefix - Spring의 cloud.aws.s3.result-key-prefix와 반드시 동일해야 함
S3_RESULT_KEY_PREFIX=xlsx/


PDF_XLSX_FILE_NAME=/app/pdf/CONFIG/{year}사건부.xlsx
PDF_FONT_PATH=/app/pdf/CONFIG/NANUMGOTHIC.TTF
# FastAPI가 처리 결과 XLSX를 임시 저장하는 컨테이너 내부 경로 -
# S3_ENABLED=true: 이후 S3(xlsx/{taskId}.xlsx)에 업로드되고, outputPath에는 S3 key가 담김
PDF_OUTPUT_PATH=/app/pdf/{task_id}.xlsx
